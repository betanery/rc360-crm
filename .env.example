# RC360 CRM — Variáveis de ambiente placeholder.
# Substitua pelos valores reais quando o backend Supabase for habilitado.
# Nunca versione chaves secretas reais no GitHub.

# Cliente do navegador (publishable / anon key)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_PUBLICA_ANON

# Opcional: ID do projeto (usado em URLs e configurações futuras)
VITE_SUPABASE_PROJECT_ID=SEU_PROJECT_ID

# Configure estes valores como Secrets quando houver backend real.
# Por enquanto permanecem vazios — nenhuma integração está ativa.
BOTCONVERSA_API_KEY=""
CRM_WEBHOOK_SECRET=""
CRON_SECRET=""
CRM_EMAIL_WEBHOOK_URL=""

# Configure no GitHub Actions > Repository secrets para permitir deploy.
SUPABASE_ACCESS_TOKEN=""
SUPABASE_DB_PASSWORD=""
